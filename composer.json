{
  "name": "marcmaerdian/fal-s3-driver",
  "description": "TYPO3 FAL driver for S3-compatible object storage (Cloudflare R2, Hetzner, MinIO, AWS S3)",
  "license": "GPL-2.0-or-later",
  "type": "typo3-cms-extension",
  "keywords": ["typo3", "fal", "driver", "s3", "cloudflare", "r2", "hetzner", "minio", "cdn"],
  "authors": [
    {
      "name": "Marc Märdian",
      "email": "kontakt@marcmaerdian.de",
      "homepage": "https://marcmaerdian.de",
      "role": "Developer"
    }
  ],
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": {
      "typo3/cms-composer-installers": true,
      "typo3/class-alias-loader": true
    }
  },
  "require": {
    "php": "^8.2",
    "aws/aws-sdk-php": "^3.300",
    "typo3/cms-core": "^14.3"
  },
  "autoload-dev": {
    "psr-4": {
      "MARCMAERDIAN\\FalS3Driver\\Tests\\": "Tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite Unit",
    "test:functional": "phpunit --testsuite Functional",
    "lint": "find Classes Tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "autoload": {
    "psr-4": {
      "MARCMAERDIAN\\FalS3Driver\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "fal_s3_driver"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  }
}
