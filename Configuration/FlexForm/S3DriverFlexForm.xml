<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <sheetTitle>S3-compatible storage</sheetTitle>
                <type>array</type>
                <el>
                    <endpoint>
                        <label>Endpoint URL</label>
                        <description>Full API endpoint, e.g. https://ACCOUNT.r2.cloudflarestorage.com (Cloudflare R2), https://fsn1.your-objectstorage.com (Hetzner) or http://localhost:9000 (MinIO). This is not the URL visitors use.</description>
                        <config>
                            <type>input</type>
                            <size>60</size>
                            <required>1</required>
                        </config>
                    </endpoint>
                    <region>
                        <label>Region</label>
                        <description>Leave empty for "auto". Providers without regions still need a value for request signing.</description>
                        <config>
                            <type>input</type>
                            <size>20</size>
                            <default>auto</default>
                        </config>
                    </region>
                    <bucket>
                        <label>Bucket name</label>
                        <config>
                            <type>input</type>
                            <size>40</size>
                            <required>1</required>
                        </config>
                    </bucket>
                    <accessKeyId>
                        <label>Access Key ID</label>
                        <config>
                            <type>input</type>
                            <size>40</size>
                            <required>1</required>
                        </config>
                    </accessKeyId>
                    <secretAccessKey>
                        <label>Secret Access Key</label>
                        <config>
                            <type>password</type>
                            <size>40</size>
                            <required>1</required>
                        </config>
                    </secretAccessKey>
                    <publicBaseUrl>
                        <label>Public base URL</label>
                        <description>Where visitors fetch files from: custom domain, r2.dev URL or CDN. Without trailing slash. Leave empty for a private storage.</description>
                        <config>
                            <type>input</type>
                            <size>60</size>
                        </config>
                    </publicBaseUrl>
                    <basePath>
                        <label>Base path inside the bucket</label>
                        <description>Optional prefix, e.g. "fileadmin". Leave empty for bucket root.</description>
                        <config>
                            <type>input</type>
                            <size>40</size>
                        </config>
                    </basePath>
                    <usePathStyleEndpoint>
                        <label>Use path-style endpoint</label>
                        <description>Bucket in the path (endpoint/bucket/key) instead of as a subdomain. Required by R2 and MinIO; AWS S3 prefers virtual-hosted style.</description>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </usePathStyleEndpoint>
                    <compatibilityMode>
                        <label>Non-AWS compatibility mode</label>
                        <description>Disables the integrity checksums the AWS SDK sends by default. Required for R2 and most other non-AWS providers, which answer 501 Not Implemented otherwise.</description>
                        <config>
                            <type>check</type>
                            <renderType>checkboxToggle</renderType>
                            <default>1</default>
                        </config>
                    </compatibilityMode>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
